# Copie para .env e troque os valores.

# Domínio público. Com um domínio apontado para o servidor, o HTTPS é automático.
# Sem domínio (teste por IP ou na sua máquina), deixe :80
SITE_ADDRESS=:80

POSTGRES_DB=bairro
POSTGRES_USER=bairro
POSTGRES_PASSWORD=troque-esta-senha

# Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo

# Chave que o scraper envia no cabeçalho x-ingest-key. Vazio = ingestão desligada.
# Gere com: openssl rand -hex 24
INGEST_API_KEY=

# Scraper do g1 (docker compose --profile scraper up -d): de quantos em quantos minutos e quantas páginas por passada.
SCRAPER_MINUTOS=15
SCRAPER_PAGINAS=3

# Resumo dos relatos com IA. Preencha UMA das opções abaixo; vazio = resumo automático, sem IA.
#
# 1) Groq (grátis, sem cartão, rápido). Crie a chave em console.groq.com > API Keys.
GROQ_API_KEY=
#
# 2) Ollama (grátis e 100% local, sem conta). Use uma das duas:
#    - container do projeto:  docker compose --profile ia-local up -d   e   OLLAMA_URL=http://ollama:11434
#    - Ollama já instalado no seu computador:  OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
#
# 3) Gemini (grátis em aistudio.google.com; no plano grátis o Google pode usar os textos para melhorar produtos).
GEMINI_API_KEY=
#
# 4) Claude (pago, console.anthropic.com).
ANTHROPIC_API_KEY=
#
# Opcional: forçar o provedor (auto, groq, ollama, gemini, anthropic) e trocar o modelo.
AI_PROVIDER=auto
AI_MODEL=

# true: seletor "Ver o app como", roteiro da banca, simulação ao vivo e restaurar dados.
# Qualquer visitante pode trocar de perfil. Use false quando houver login de verdade.
DEMO_MODE=true

# Só para rodar a API fora do Docker (npm run dev em api/):
# DATABASE_URL=postgres://bairro:troque-esta-senha@localhost:5432/bairro
